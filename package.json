{
  "name": "lyrica",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@lyrica/mobile",
    "mobile:android": "npm run android --workspace=@lyrica/mobile",
    "mobile:ios": "npm run ios --workspace=@lyrica/mobile",
    "mobile:web": "npm run web --workspace=@lyrica/mobile",
    "api": "npm run dev --workspace=@lyrica/api",
    "api:build": "npm run build --workspace=@lyrica/api",
    "api:start": "npm run start --workspace=@lyrica/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "doctor": "npm run doctor --workspace=@lyrica/mobile",
    "mobile:tunnel": "bash scripts/mobile-tunnel.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
